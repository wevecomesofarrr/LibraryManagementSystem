package LibraryManagmentSystemOOP;
import java.util.ArrayList;
public class LibrarySystem {
	//Fields
    private ArrayList<Book> bookList;
    private ArrayList<Member> memberList;
    
    //Constructor
    public LibrarySystem() {
        bookList = new ArrayList<>();   
        memberList = new ArrayList<>();
        //Sample data - addBook
        addBook("B001", "Harry Potter", "J.K. Rowling");
        addBook("B002", "The Hobbit", "J.R.R. Tolkien");
        addBook("B003", "1984", "George Orwell");
        // adding books to each member
        ArrayList<Book> ayahBooks = new ArrayList<>();
        ayahBooks.add(bookList.get(0));
        ArrayList<Book> lamaBooks = new ArrayList<>();
        lamaBooks.add(bookList.get(2));
      //Sample data - addMember
    	addMember(446000000,"Ayah",ayahBooks);
        addMember(446000164, "Lama",  lamaBooks);
    }
    

    //add a new book - method
    public void addBook(String id, String title, String author) {
        Book newBook = new Book(id, title, author);
        bookList.add(newBook); 
        System.out.println("Book added successfully.");
    }

    //display books 
    public void displayAllBooks() {
        System.out.println("--- All Books ---");
        for (Book b : bookList) b.displayBookInfo();
    }

    //searsh for a books- method
    public Book searchBookByTitle(String title) {
        for (Book b : bookList) {
            if (b.getTitle().equals(title)) {
                b.displayBookInfo();
                return b;
            }
        }
        System.out.println("Book not found.");
        return null;
    }
    
    //add a new member - method
    public void addMember ( int Id, String name, ArrayList<Book>borrowedBooks) {
    	Member newMember = new Member(Id, name, borrowedBooks);
    	memberList.add(newMember);
    	System.out.println("Member added successfully");
    }
    
    //display members
    public void displayAllMembers() {
    	System.out.println("--- All Members ---");
    	for(Member l: memberList)l.displayBorrowedBooks();
    }
    
}
